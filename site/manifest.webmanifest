{
  "id": "./",
  "name": "Taaza · తాజా",
  "short_name": "Taaza",
  "description": "Ad-free news in English & Telugu with your city’s news and daily gold rates.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f7f5f0",
  "theme_color": "#1f5fbf",
  "categories": ["news", "finance"],
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Gold rate", "short_name": "Gold", "url": "./#/gold", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "All news", "short_name": "News", "url": "./#/news", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "assets/screens/phone-home.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "City news and gold rates" },
    { "src": "assets/screens/phone-gold.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Gold rates for every karat" },
    { "src": "assets/screens/desktop.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Desktop view" }
  ]
}
